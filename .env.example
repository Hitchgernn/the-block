# The Block — environment
# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Turso (libSQL) --------------------------------------------------------
# turso db show --url the-block
TURSO_DATABASE_URL=libsql://the-block-<org>.turso.io
# turso db tokens create the-block
TURSO_AUTH_TOKEN=

# --- Slack -----------------------------------------------------------------
# Bot User OAuth Token from api.slack.com/apps -> OAuth & Permissions
# Required scopes: chat:write, users:read
SLACK_BOT_TOKEN=xoxb-
# Channel the agent posts asks and the digest into (e.g. C01ABCDEF23)
SLACK_CHANNEL_ID=

# --- AWS Bedrock -----------------------------------------------------------
# Region where Bedrock model access is actually granted
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model id enabled in that region — confirm in the Bedrock console before use
BEDROCK_MODEL_ID=

# --- Cron ------------------------------------------------------------------
# Guards /api/cron/* so only Vercel's scheduler can invoke them.
# Note: /api/trigger/* stays unauthenticated on purpose - design.md section 5
# puts a "Run the agent" button in front of judges who have no credentials.
CRON_SECRET=

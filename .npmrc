# @strands-agents/sdk declares 23 peer deps (openai, google genai, cedar-wasm,
# all of opentelemetry) and an optional dep chain that reaches node-llama-cpp
# with CUDA binaries. Neither is needed to talk to Bedrock.
legacy-peer-deps=true

# This link times out on large tarballs at npm's defaults.
fetch-timeout=1800000
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=300000
maxsockets=3
